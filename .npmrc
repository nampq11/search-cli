# .npmrc - npm configuration for @nampham1106/search-cli

# Use public registry for @nampham1106 scoped packages
@nampham1106:registry=https://registry.npmjs.org/

# Always install with exact versions (no caret/range)
# save-exact=true

# Use package-lock.json
package-lock=true

# Engine strict - fail if Node version doesn't match package.json
engine-strict=true

auto-install-peers=false