{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "off"
  },
  "env": {
    "es2022": true,
    "node": true
  },
  "ignore": ["node_modules", "dist", "coverage", "*.config.js", "*.config.ts"]
}
