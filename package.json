{
  "name": "@nampham1106/search-cli",
  "version": "1.0.0",
  "description": "A modern TypeScript CLI tool for web search and content fetching powered by DuckDuckGo",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "search-cli": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "biome check src tests",
    "check:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "search",
    "cli",
    "duckduckgo",
    "web-scraping",
    "markdown",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "turndown": "^7.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "oxlint": "0.11.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
